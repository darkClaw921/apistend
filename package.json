{
  "name": "apistend-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "pnpm --filter @apistend/api exec prisma migrate dev",
    "db:push": "pnpm --filter @apistend/api exec prisma db push",
    "db:seed": "pnpm --filter @apistend/api run db:seed",
    "db:studio": "pnpm --filter @apistend/api exec prisma studio",
    "ingest": "pnpm --filter @apistend/catalog-ingest run ingest",
    "vendor:b24": "bash scripts/vendor-bitrix24-docs.sh && node scripts/fetch-bitrix24-ru.mjs",
    "clean": "git clean -xdf node_modules dist .next .turbo"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  }
}
