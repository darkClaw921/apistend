{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // API на проде исполняется как есть: `node src/server.ts`, Node снимает типы
    // на лету и НЕ транспилирует. Поэтому enum, namespace и параметры-свойства
    // конструктора там падают с SyntaxError. Vitest их выполняет, tsc без этого
    // флага молчит — то есть без него сборка зелёная, а прод в крэш-лупе.
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true
  },
  "exclude": ["node_modules", "dist", ".next", ".turbo"]
}
