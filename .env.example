# Порт 5433, чтобы не конфликтовать с локально установленным PostgreSQL
DATABASE_URL="postgresql://apistend:apistend@localhost:5433/apistend?schema=public"

# openssl rand -base64 32
JWT_SECRET="dev-only-change-me-0000000000000000000000000="

API_PORT=8080
WEB_PORT=3100

# Базовый адрес API для веб-приложения и для CLI
NEXT_PUBLIC_API_URL="http://localhost:8080"
APISTEND_PUBLIC_ORIGIN="http://localhost:8080"
DB_POOL_SIZE=12
APISTEND_LOG_SAMPLE_RPS=300
APISTEND_LOG_RETENTION_DAYS=30

# ── Серии событий: нагрузочная проверка вебхуков ──
# Потолки на одну серию. Запрос выше обрезается, и об этом сообщается в ответе,
# а не молча: молчаливое усечение читается как «сделано, как просили».
BURST_MAX_RATE=500
BURST_MAX_COUNT=100000
BURST_MAX_CONCURRENT=3

# Разрешать доставку вебхуков на приватные адреса (localhost, 10/8, 192.168/16, ::1).
# В разработке нужно: API и приложение на одной машине. В общем сервисе — нет:
# адрес из чужой песочницы стал бы каналом во внутреннюю сеть, тем более под серией.
# Пусто — разрешено вне production. 1 — разрешить всегда, 0 — запретить всегда.
WEBHOOK_ALLOW_PRIVATE_TARGETS=
