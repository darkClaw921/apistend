// APIStend — модель данных.
// Источник: design-handoff/03-data-model.md, с правками из плана проекта:
//  - Webhook.targetPath для локальной доставки (в протоколе туннеля нет абсолютных URL);
//  - WebhookDelivery хранит сырое тело и content-type (у Bitrix24 это form-urlencoded, не JSON);
//  - ApiMethod несёт поля происхождения, чтобы неполный каталог не выдавался за полный.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Аккаунт ───────────────────────────

model User {
  id           String   @id @default(cuid())
  /// Имя для входа. Регистрация и вход идут по нему, а не по почте:
  /// песочница не рассылает писем, подтверждать адрес нечем, и требовать
  /// настоящую почту ради входа значит просить лишнее.
  login        String   @unique
  /// Почта — необязательная и только для связи: восстановления пароля по ней нет.
  email        String?  @unique
  passwordHash String
  name         String
  // Инициалы для аватара в сайдбаре: «ИГ».
  initials     String
  // «Бесплатный доступ» — подпись под именем в сайдбаре.
  planLabel    String   @default("Бесплатный доступ")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sandboxes Sandbox[]
  sessions  AuthSession[]

  @@map("users")
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  // Хеш refresh-токена: сам токен в базе не хранится.
  tokenHash String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

// ─────────────────────────── Песочница ───────────────────────────

enum DataVolume {
  min
  medium
  full
}

model Sandbox {
  id        String     @id @default(cuid())
  userId    String
  // «sandbox-01» — значение в переключателе песочницы.
  name      String
  // «Интеграция 1С» — попадает в хлебные крошки.
  project   String
  status    String     @default("ok")
  dataVolume DataVolume @default(medium)
  // Искусственная задержка ответов, 0–3000 мс.
  latencyMs Int        @default(250)
  // Доля случайных ошибок, 0–50 %.
  errorRate Int        @default(5)
  /**
   * Открыт ли доступ к песочнице по MCP для ИИ-агента.
   *
   * Выключено по умолчанию, и это не осторожность ради осторожности: агент,
   * получивший ключ, может вызывать моки и читать журнал запросов — то есть
   * видеть тела запросов, которые писал человек. Такое включают осознанно,
   * а не обнаруживают включённым.
   */
  mcpEnabled Boolean  @default(false)
  lastResetAt DateTime @default(now())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeys     ApiKey[]
  requestLogs RequestLog[]
  webhooks    Webhook[]
  deliveries  WebhookDelivery[]
  tunnels     TunnelSession[]
  scenarios   Scenario[]
  bursts      EventBurst[]
  customMocks CustomMock[]
  alerts      Alert[]
  overlay     SandboxOverlay[]
  b24Apps     B24App[]

  @@unique([userId, name])
  @@map("sandboxes")
}

// ─────────────────────────── Каталог ───────────────────────────

enum Readiness {
  ready
  updating
  planned
}

model ApiMethod {
  id          String    @id
  serviceCode String
  httpMethod  String
  path        String
  title       String
  description String    @db.Text
  // Раздел внутри сервиса — заголовок группы в списке методов.
  group       String
  version     String
  readiness   Readiness @default(ready)
  deprecated  Boolean   @default(false)
  latencyMs   Int       @default(180)
  callsCount  Int       @default(0)

  // Параметры и сценарии ответа — JSON, форма описана в @apistend/shared.
  params    Json
  scenarios Json

  // ── происхождение: без этих полей неполный каталог превращается в ложь ──
  // example | schema | generic
  responseSource String
  // spec | mirror | parsed
  extraction     String
  sourceUrl      String
  // Дата снимка спецификации: показывается рядом со счётчиком методов.
  snapshotDate   String
  license        String?

  updatedAt DateTime @updatedAt

  @@unique([serviceCode, httpMethod, path])
  @@index([serviceCode, group])
  @@index([serviceCode, readiness])
  @@map("api_methods")
}

/// Сводка по сервису для панели «Демо-сервисы» и лендинга.
/// Числа считаются из api_methods, а не зашиваются в вёрстку.
model ServiceStat {
  serviceCode  String   @id
  status       String   @default("ok")
  methodsCount Int      @default(0)
  eventsCount  Int      @default(0)
  snapshotDate String
  updatedAt    DateTime @updatedAt

  @@map("service_stats")
}

// ─────────────────────────── Ключи ───────────────────────────

enum ApiKeyStatus {
  active
  expiring
  revoked
}

enum ApiKeyKind {
  /// stend_sbx_… — ключ песочницы, им код пользователя ходит в мок-API.
  sandbox
  /// stend_sk_… — серверный ключ, им авторизуется CLI.
  server
}

model ApiKey {
  id        String       @id @default(cuid())
  sandboxId String
  name      String
  /// «Сервер обмена · 1С:УТ 11» — вторая строка в ячейке названия.
  subtitle  String?
  kind      ApiKeyKind   @default(sandbox)
  /// Первые символы ключа: stend_sbx_7f3a. Показываются всегда.
  prefix    String
  /// Последние символы: 4c21. Вместе с prefix дают маску stend_sbx_7f3a••••••4c21.
  suffix    String
  /// Argon2id от полного ключа. Полный ключ показывается один раз при создании.
  keyHash   String       @unique
  services  String[]
  /// Области доступа к Management API: keys:read, webhooks:write и так далее.
  /// Пустой массив — полный доступ: все ключи, выданные до появления областей,
  /// продолжают работать, а «ключ без прав» иначе означал бы бесполезный ключ.
  scopes    String[]     @default([])
  status    ApiKeyStatus @default(active)
  rotationDays Int       @default(90)
  expiresAt DateTime?
  lastUsedAt DateTime?
  revokedAt DateTime?
  revokedBy String?
  requestsPerDay Int     @default(0)
  createdAt DateTime     @default(now())

  sandbox    Sandbox      @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  requestLogs RequestLog[]
  tunnels    TunnelSession[]

  @@index([sandboxId, status])
  @@map("api_keys")
}

// ─────────────────────────── Логи ───────────────────────────

model RequestLog {
  id          String   @id @default(cuid())
  sandboxId   String
  apiKeyId    String?
  /// req_8f3c21a0d7 — показывается в панели деталей запроса.
  publicId    String   @unique
  timestamp   DateTime @default(now())
  serviceCode String
  httpMethod  String
  endpoint    String
  statusCode  Int
  durationMs  Int
  sizeBytes   Int
  /// Боевой адрес, который был бы вызван без APIStend.
  upstreamUrl String?
  clientIp    String?
  scenario    String   @default("success")
  /// example | schema | generic — откуда взят ответ.
  responseSource String @default("example")

  requestHeaders  Json
  requestBody     String? @db.Text
  responseHeaders Json
  responseBody    String? @db.Text

  sandbox Sandbox @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  apiKey  ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([sandboxId, timestamp(sort: Desc)])
  @@index([sandboxId, statusCode])
  @@index([sandboxId, serviceCode])
  /// Фильтр журнала по ключу и подсчёт вызовов перед удалением ключа: оба
  /// обращения появились с Management API и без индекса читали таблицу целиком.
  @@index([sandboxId, apiKeyId, timestamp(sort: Desc)])
  @@map("request_logs")
}

// ─────────────────────────── Вебхуки ───────────────────────────

enum WebhookStatus {
  active
  paused
  failing
  disabled
}

enum DeliveryTarget {
  /// Публичный адрес: сервер APIStend делает запрос сам.
  public
  /// localhost разработчика: запрос делает CLI на его машине.
  local
}

model Webhook {
  id          String         @id @default(cuid())
  sandboxId   String
  serviceCode String
  event       String
  httpMethod  String         @default("POST")
  target      DeliveryTarget @default(public)
  /// Для target = public. Абсолютный адрес получателя.
  targetUrl   String?
  /// Для target = local. ТОЛЬКО относительный путь: /wb/stocks.
  /// Базу подставляет CLI из --forward — в протоколе абсолютных URL нет.
  targetPath  String?
  status      WebhookStatus  @default(active)
  /// Секрет подписи. У профилей с HMAC уходит в X-Hub-Signature.
  secret      String
  lastAttemptAt DateTime?
  successRate24h Float       @default(100)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  /// Подписка локального приложения (event.bind), а не пользователя.
  /// Одна таблица на оба случая намеренно: конверт доставки, журнал и повторы
  /// у них общие, а раздвоение дало бы два несовпадающих «Журнала доставок».
  appId       String?

  sandbox    Sandbox           @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  /// SetNull, а не Cascade: удаление приложения не должно стирать из журнала
  /// доставок запись о том, что ONAPPUNINSTALL ушёл. Подписки самого приложения
  /// снимаются явно — так же, как это делает боевой портал.
  app        B24App?           @relation(fields: [appId], references: [id], onDelete: SetNull)
  deliveries WebhookDelivery[]
  bursts     EventBurst[]

  @@index([sandboxId, serviceCode])
  @@index([appId])
  @@map("webhooks")
}

enum DeliveryState {
  /// В очереди: агент отключён или ждём слот.
  queued
  /// Отдано агенту либо отправлено на публичный адрес, ответа ещё нет.
  dispatched
  succeeded
  failed
  /// Ответ так и не пришёл в отведённое время. Без этого состояния
  /// доставка навсегда зависает в «попытка 1/5».
  no_response
  /// Выброшено из очереди по переполнению или устареванию.
  dropped
}

model WebhookDelivery {
  id          String        @id @default(cuid())
  sandboxId   String
  webhookId   String
  event       String
  serviceCode String
  timestamp   DateTime      @default(now())
  state       DeliveryState @default(queued)
  attempt     Int           @default(1)
  maxAttempts Int           @default(1)
  statusCode  Int?
  durationMs  Int?
  nextRetryAt DateTime?

  /// Куда ушло: относительный путь для local, абсолютный URL для public.
  targetDisplay String
  /// Сырое тело запроса как строка. У Bitrix24 это form-urlencoded, а не JSON,
  /// поэтому JSON-колонка тут была бы ошибкой.
  rawBody       String  @db.Text
  contentType   String
  requestHeaders Json
  responseBody  String? @db.Text
  errorKind     String?
  errorMessage  String?

  /// Серия, в рамках которой создана доставка. null — одиночный «Тест».
  burstId String?

  sandbox Sandbox @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([sandboxId, timestamp(sort: Desc)])
  @@index([burstId])
  @@index([sandboxId, state, timestamp])
  @@index([webhookId])
  @@map("webhook_deliveries")
}

// ─────────────────────────── Туннель ───────────────────────────

model TunnelSession {
  id        String    @id @default(cuid())
  sandboxId String
  apiKeyId  String
  /// tnl-8f21 — короткий идентификатор для интерфейса. Стабилен для устройства,
  /// чтобы при обрыве связи в UI ничего не мигало.
  displayId String
  /// Хеш одноразового токена подключения (tnlt_…), TTL 10 минут.
  tokenHash String    @unique
  /// Когда токен предъявили. Одноразовость была заявлена в комментарии выше,
  /// но не проверялась: одним токеном можно было подключиться сколько угодно раз
  /// и вытеснять чужого агента.
  usedAt    DateTime?
  deviceId  String
  deviceName String?
  agentVersion String
  /// Абсолютный адрес пересылки — только для показа в интерфейсе.
  /// Сервер им никогда не пользуется при построении запроса.
  forwardUrl String
  signingSecret String
  connected Boolean   @default(false)
  latencyMs Int?
  /// Заготовка под несколько инстансов: пока всегда одно значение.
  gwNodeId  String    @default("gw-0")
  connectedAt DateTime?
  lastSeenAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  sandbox Sandbox @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  apiKey  ApiKey  @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([sandboxId, connected])
  @@index([sandboxId, displayId])
  @@map("tunnel_sessions")
}

// ─────────────────────────── Сценарии и свои моки ───────────────────────────

model Scenario {
  id          String   @id @default(cuid())
  sandboxId   String
  name        String
  serviceCode String
  /// Сколько событий отправляет один запуск.
  stepsCount  Int
  status      String   @default("ready")
  delayMs     Int      @default(5000)
  /// Скорость запуска, событий в секунду. Задержка delayMs описывает то же самое,
  /// но для нагрузочной проверки удобнее задавать скорость, а не интервал:
  /// «200 событий в секунду» читается, «5 мс между событиями» — нет.
  ratePerSec  Int      @default(5)
  repeats     Int      @default(1)
  errorRate   Int      @default(0)
  progress    Int      @default(0)
  lastRunAt   DateTime?
  lastRunNote String?
  steps       Json

  sandbox Sandbox      @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  runs    EventBurst[]

  @@index([sandboxId])
  @@map("scenarios")
}

/// Состояние серии. Прерванная — это серия, которую застал перезапуск процесса:
/// расписание живёт в памяти, поэтому после рестарта она не продолжится, и делать
/// вид, что она всё ещё идёт, нельзя.
enum BurstState {
  running
  done
  stopped
  interrupted
}

/// Серия событий: N доставок с заданной скоростью.
///
/// Одна и та же сущность обслуживает и `apistend trigger --count --rate`,
/// и запуск сценария симуляции из интерфейса — у сценария просто заполнен scenarioId.
model EventBurst {
  id          String     @id @default(cuid())
  sandboxId   String
  webhookId   String
  scenarioId  String?
  event       String
  serviceCode String
  state       BurstState @default(running)

  /// Сколько событий заказано и с какой скоростью. Значения уже после обрезки
  /// по потолкам — что именно попросили, видно в requestedRatePerSec.
  count            Int
  ratePerSec       Int
  requestedCount     Int
  requestedRatePerSec Int
  /// Доля доставок, которым сервер намеренно портит полезную нагрузку,
  /// чтобы приложение получило ошибочный ответ. 0 — не портить.
  errorRate        Int      @default(0)

  sent      Int @default(0)
  succeeded Int @default(0)
  failed    Int @default(0)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  note       String?

  sandbox  Sandbox   @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  webhook  Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  scenario Scenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)

  @@index([sandboxId, startedAt(sort: Desc)])
  @@index([sandboxId, state])
  @@map("event_bursts")
}

enum CustomMockStatus {
  active
  draft
  disabled
}

model CustomMock {
  id          String           @id @default(cuid())
  sandboxId   String
  httpMethod  String
  path        String
  title       String
  status      CustomMockStatus @default(draft)
  responseStatusCode Int       @default(200)
  contentType String           @default("application/json")
  delayMs     Int              @default(250)
  templatingEnabled Boolean    @default(true)
  /// Сырой шаблон с плейсхолдерами. Сервер обязан уметь вернуть и его, и результат подстановки.
  responseBody String          @db.Text
  headers     Json
  rules       Json
  callsCount  Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  sandbox Sandbox @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@unique([sandboxId, httpMethod, path])
  @@index([sandboxId, status])
  @@map("custom_mocks")
}

model Alert {
  id        String   @id @default(cuid())
  sandboxId String
  severity  String
  title     String
  meta      String
  icon      String
  link      String?
  /// Когда уведомление прочитали. Хранится время, а не флаг: «прочитано вчера»
  /// и «прочитано только что» — разные вещи для того, кто разбирает накопившееся.
  readAt    DateTime?
  createdAt DateTime @default(now())

  sandbox Sandbox @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@index([sandboxId])
  @@index([sandboxId, readAt])
  @@map("alerts")
}

// ─────────────────── Локальные приложения Bitrix24 ───────────────────

/// Вид локального приложения. В боевой форме портала селектора «тип» нет: вид
/// определяется тем, какие поля заполнены. Явное значение нужно интерфейсу
/// и проверкам — иначе «приложение без интерфейса» пришлось бы каждый раз
/// выводить из пустоты handlerUrl.
enum B24AppKind {
  server_ui
  api_only
}

enum B24AppState {
  /// Создано, но ни разу не открывалось. app.info → INSTALLED: false.
  awaiting_install
  /// Вызван BX24.installFinish() либо доставлен ONAPPINSTALL для api_only.
  installed
  /// Удалено пользователем. Токены отозваны, обработчики сняты.
  uninstalled
}

/// Локальное приложение Bitrix24, зарегистрированное в песочнице.
///
/// Боевой портал выдаёт client_id и client_secret один раз при сохранении формы
/// и больше их не меняет; повторное добавление приложения с теми же адресами
/// создаёт НОВУЮ пару. Здесь так же: перевыпуска нет, есть удаление и создание.
model B24App {
  id          String      @id @default(cuid())
  sandboxId   String
  title       String
  /// Символьный код: попадает в app.info.CODE и в ссылку REST_APP_URI.
  code        String
  /// local.68bd4f2a91c3e7.45120983 — формат боевого портала, включая длины частей.
  clientId    String      @unique
  /// 50 символов. Участвует только в запросах к серверу авторизации.
  clientSecret String
  kind        B24AppKind  @default(server_ui)
  state       B24AppState @default(awaiting_install)
  scope       String[]
  /// «Путь вашего обработчика». Для api_only пуст.
  handlerUrl  String?
  /// «Путь для первоначальной установки». Для server_ui — мастер установки во фрейме,
  /// для api_only — серверный обработчик ONAPPINSTALL.
  installUrl  String?
  /// Название пункта в главном меню портала. У api_only пункта нет.
  menuTitle   String?
  /// Постоянный токен приложения на этом портале. Приходит и во фрейм (APPLICATION_TOKEN),
  /// и обработчикам событий (auth[application_token]) — по нему приложение проверяет,
  /// что запрос действительно от портала.
  applicationToken String
  version     Int         @default(1)
  /// Срок жизни access_token в секундах. Боевой портал всегда даёт час, и это
  /// единственное осознанное расхождение: дождаться протухания при отладке иначе
  /// нельзя, а проверять надо именно обработку expired_token.
  tokenTtlSeconds Int     @default(3600)
  /// Срок жизни refresh_token. Короткое значение позволяет проверить и вторую
  /// ветку: когда обновлять уже нечем и приложение обязано пройти OAuth заново.
  refreshTtlSeconds Int   @default(15552000)
  installedAt DateTime?
  /// Причина последней неудачной установки: пустой фрейм, отказ обработчика, таймаут.
  lastInstallNote String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  sandbox    Sandbox              @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  tokens     B24AppToken[]
  authCodes  B24AuthCode[]
  placements B24AppPlacement[]
  webhooks   Webhook[]
  sessions   B24AppSession[]

  @@unique([sandboxId, code])
  @@index([sandboxId, state])
  @@map("b24_apps")
}

/// Пара токенов OAuth 2.0, выданная приложению для конкретного сотрудника портала.
///
/// Хранится в открытом виде сознательно: это демо-портал, и вся ценность экрана
/// «Токены» в том, что выданный access_token можно скопировать и вставить в curl.
/// Ключи самого APIStend (stend_sk_) по-прежнему лежат только хешами.
model B24AppToken {
  id           String   @id @default(cuid())
  appId        String
  accessToken  String   @unique
  refreshToken String   @unique
  /// Сотрудник портала, от чьего имени выписан токен.
  portalUserId Int      @default(1)
  scope        String[]
  expiresAt    DateTime
  /// Срок refresh_token. Боевое значение — 180 суток.
  refreshExpiresAt DateTime
  /// Пара отозвана совсем: приложение удалено или установка сброшена.
  /// Такой токен неотличим от мусорного — портал отвечает NO_AUTH_FOUND.
  revokedAt    DateTime?
  /// Пара замещена новой при обновлении. Это НЕ то же самое, что отзыв:
  /// клиент обязан получить expired_token и пойти обновляться, иначе
  /// библиотека, которая повторяет вызов только на этой ошибке, сдастся.
  supersededAt DateTime?
  createdAt    DateTime @default(now())

  app B24App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, revokedAt])
  @@map("b24_app_tokens")
}

/// Одноразовый авторизационный код. Живёт 30 секунд, как в бою.
model B24AuthCode {
  id        String   @id @default(cuid())
  appId     String
  code      String   @unique
  portalUserId Int   @default(1)
  state     String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  app B24App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@map("b24_auth_codes")
}

/// Зарегистрированный виджет: placement.bind.
model B24AppPlacement {
  id          String   @id @default(cuid())
  appId       String
  placement   String
  handler     String
  title       String?
  description String?
  groupName   String?
  options     Json
  createdAt   DateTime @default(now())

  app B24App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, placement, handler])
  @@index([appId])
  @@map("b24_app_placements")
}


/// Одно открытие приложения во фрейме.
///
/// APP_SID боевой портал создаёт заново при каждой отрисовке и использует, чтобы
/// «связать js-библиотеку с окружением приложения». У нас он делает ровно то же:
/// страница портала адресует кадры моста конкретному фрейму, а сервер по нему
/// понимает, чей installFinish пришёл.
model B24AppSession {
  id        String   @id @default(cuid())
  appId     String
  appSid    String   @unique
  tokenId   String?
  placement String   @default("DEFAULT")
  placementOptions Json
  /// Показан мастер установки, а не обработчик.
  isInstall Boolean  @default(false)
  finishedAt DateTime?
  createdAt DateTime @default(now())

  app B24App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, createdAt])
  @@map("b24_app_sessions")
}

// ─────────────────────────── Датасет ───────────────────────────

/// Общий read-only датасет, собранный на этапе сборки. Одинаков для всех песочниц,
/// поэтому создание песочницы — операция O(1).
model DatasetEntity {
  serviceCode String
  entityType  String
  /// Порядковый номер внутри типа. Идентификатор, который отдаёт мок,
  /// разбирается обратно в пару (entityType, ordinal) — поэтому get(id) работает
  /// даже для записи, не попавшей в list.
  ordinal     Int
  /// Идентификатор в формате сервиса: "1042" у Bitrix24, "24219509-0020-1" у Ozon.
  externalId  String
  volume      DataVolume @default(min)
  data        Json

  @@id([serviceCode, entityType, ordinal])
  @@index([serviceCode, entityType, externalId])
  @@map("dataset_entities")
}

/// Изменения пользователя поверх общего датасета. Чтение — overlay ?? base.
/// «Сбросить сейчас» — это DELETE по песочнице.
model SandboxOverlay {
  id          String   @id @default(cuid())
  sandboxId   String
  serviceCode String
  entityType  String
  externalId  String
  /// true — запись удалена пользователем: базовая версия не должна возвращаться.
  deleted     Boolean  @default(false)
  data        Json?
  updatedAt   DateTime @updatedAt

  sandbox Sandbox @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@unique([sandboxId, serviceCode, entityType, externalId])
  @@index([sandboxId, serviceCode, entityType])
  @@map("sandbox_overlays")
}
